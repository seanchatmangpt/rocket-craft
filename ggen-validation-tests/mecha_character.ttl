@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ue4: <https://rocket-craft.io/ontology/ue4/> .
@prefix mecha: <https://rocket-craft.io/ontology/ue4/mecha#> .

<https://rocket-craft.io/ontology/ue4/mecha#>
    a owl:Ontology ;
    rdfs:label "Mecha Player Character Scenario Ontology" ;
    rdfs:comment "Ontology defining the Mecha player character scenario and graph connections." .

# =========================================================================
# Mecha Classes & Component Classes
# =========================================================================

mecha:AMechaCharacter a owl:Class ;
    rdfs:subClassOf ue4:ACharacter ;
    rdfs:label "AMechaCharacter" ;
    rdfs:comment "A specialized character subclass representing a Mecha mobile suit." .

ue4:USkeletalMeshComponent a owl:Class ;
    rdfs:subClassOf ue4:USceneComponent ;
    rdfs:label "USkeletalMeshComponent" ;
    rdfs:comment "Skeletal mesh rendering component." .

ue4:UBoxComponent a owl:Class ;
    rdfs:subClassOf ue4:USceneComponent ;
    rdfs:label "UBoxComponent" ;
    rdfs:comment "Box collision physics component." .

# =========================================================================
# Mecha Character & Components Instances
# =========================================================================

mecha:MyMecha a mecha:AMechaCharacter ;
    rdfs:label "MyMecha" ;
    rdfs:comment "The primary Mecha player character instance." ;
    ue4:hasComponent mecha:MechaMesh ;
    ue4:hasComponent mecha:MechaCollision ;
    ue4:hasGraph mecha:MechaInputGraph ;
    ue4:bReplicates true ;
    ue4:hasCookingState mecha:Cooked .

mecha:MechaMesh a ue4:USkeletalMeshComponent ;
    rdfs:label "MechaMesh" ;
    rdfs:comment "Skeletal mesh rendering component for the Mecha." ;
    ue4:owner mecha:MyMecha .

mecha:MechaCollision a ue4:UBoxComponent ;
    rdfs:label "MechaCollision" ;
    rdfs:comment "Collision bounding box for physical interaction." ;
    ue4:owner mecha:MyMecha .

# =========================================================================
# Subsystem Handler
# =========================================================================

mecha:MechaNetworkingHandler a ue4:UNetworkingSubsystem ;
    rdfs:label "MechaNetworkingHandler" ;
    rdfs:comment "Networking subsystem handler for character replication." .

# =========================================================================
# Typestates
# =========================================================================

mecha:Cooked a ue4:CookingTypestate ;
    rdfs:label "Cooked" ;
    rdfs:comment "Asset cooking state: Cooked." .

mecha:WasmReady a ue4:WasmPackagingTypestate ;
    rdfs:label "WasmReady" ;
    rdfs:comment "Wasm packaging state: WasmReady." .

# =========================================================================
# World & Level Configuration
# =========================================================================

mecha:MechaWorld a ue4:UWorld ;
    rdfs:label "MechaWorld" ;
    rdfs:comment "Persistent world container." ;
    ue4:hasLevel mecha:MechaLevel ;
    ue4:hasPackagingState mecha:WasmReady .

mecha:MechaLevel a ue4:ULevel ;
    rdfs:label "MechaLevel" ;
    rdfs:comment "Persistent level containing the Mecha character." ;
    ue4:hasActor mecha:MyMecha ;
    ue4:isLevelOf mecha:MechaWorld .

# =========================================================================
# C++ Reflection: Function Definitions
# =========================================================================

ue4:AddMovementInput a ue4:UFunction ;
    rdfs:label "AddMovementInput" ;
    rdfs:comment "Adds movement input vector along a world direction." ;
    ue4:hasParameter ue4:WorldDirectionParam ;
    ue4:hasParameter ue4:ScaleValueParam .

ue4:WorldDirectionParam a ue4:UFunctionParameter ;
    rdfs:label "WorldDirectionParam" ;
    rdfs:comment "The direction vector parameter." ;
    ue4:parameterOf ue4:AddMovementInput ;
    ue4:parameterDirection ue4:Input ;
    ue4:parameterIndex 0 .

ue4:ScaleValueParam a ue4:UFunctionParameter ;
    rdfs:label "ScaleValueParam" ;
    rdfs:comment "The scale multiplier parameter." ;
    ue4:parameterOf ue4:AddMovementInput ;
    ue4:parameterDirection ue4:Input ;
    ue4:parameterIndex 1 .

# =========================================================================
# Blueprint Graph & Node Network
# =========================================================================

mecha:MechaInputGraph a ue4:UEdGraph ;
    rdfs:label "MechaInputGraph" ;
    rdfs:comment "Blueprint graph handling input events for the Mecha character." ;
    ue4:hasNode mecha:W_KeyPressedNode ;
    ue4:hasNode mecha:MoveForwardCallNode .

mecha:W_KeyPressedNode a ue4:UK2Node_InputKeyEvent ;
    rdfs:label "W_KeyPressedNode" ;
    rdfs:comment "Keyboard input event for W key." ;
    ue4:nodeOf mecha:MechaInputGraph ;
    ue4:hasPin mecha:W_KeyPressedPinOut .

mecha:MoveForwardCallNode a ue4:UK2Node_CallFunction ;
    rdfs:label "MoveForwardCallNode" ;
    rdfs:comment "Function call node invoking AddMovementInput." ;
    ue4:nodeOf mecha:MechaInputGraph ;
    ue4:callsFunction ue4:AddMovementInput ;
    ue4:hasPin mecha:MoveForwardPinIn ;
    ue4:hasPin mecha:MoveForwardDirPin ;
    ue4:hasPin mecha:MoveForwardScalePin .

# Pins for Key Pressed Node
mecha:W_KeyPressedPinOut a ue4:UEdGraphPin ;
    rdfs:label "W_KeyPressedPinOut" ;
    rdfs:comment "Pressed execution flow output." ;
    ue4:pinOf mecha:W_KeyPressedNode ;
    ue4:pinDirection ue4:Output ;
    ue4:pinCategory "exec" ;
    ue4:connectedTo mecha:MoveForwardPinIn .

# Pins for AddMovementInput Call Node
mecha:MoveForwardPinIn a ue4:UEdGraphPin ;
    rdfs:label "MoveForwardPinIn" ;
    rdfs:comment "Input execution pin to execute function." ;
    ue4:pinOf mecha:MoveForwardCallNode ;
    ue4:pinDirection ue4:Input ;
    ue4:pinCategory "exec" ;
    ue4:connectedTo mecha:W_KeyPressedPinOut .

mecha:MoveForwardDirPin a ue4:UEdGraphPin ;
    rdfs:label "MoveForwardDirPin" ;
    rdfs:comment "Input data pin for world direction." ;
    ue4:pinOf mecha:MoveForwardCallNode ;
    ue4:pinDirection ue4:Input ;
    ue4:pinCategory "struct" ;
    ue4:mapsToParameter ue4:WorldDirectionParam .

mecha:MoveForwardScalePin a ue4:UEdGraphPin ;
    rdfs:label "MoveForwardScalePin" ;
    rdfs:comment "Input data pin for scale value." ;
    ue4:pinOf mecha:MoveForwardCallNode ;
    ue4:pinDirection ue4:Input ;
    ue4:pinCategory "float" ;
    ue4:mapsToParameter ue4:ScaleValueParam .
