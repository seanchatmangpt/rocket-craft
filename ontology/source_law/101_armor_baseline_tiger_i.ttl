@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix eng: <http://rocket-craft.com/ontology/engineering#> .
@prefix factory: <http://rocket-craft.com/ontology/factory#> .
@prefix metrics: <http://rocket-craft.com/ontology/metrics#> .

eng:ArmorBaseline_Tiger_I_V0 a owl:Class, sh:NodeShape ;
    rdfs:label "ARMOR_BASELINE_TIGER_I_V0" ;
    rdfs:comment "A historically grounded metrology baseline for heavy, flat-plate welded armor, derived from the WW2 Tiger I tank." ;
    factory:sourceClass "ww2_heavy_tank" ;
    factory:geometryStyle "flat_plate_welded_box" ;
    
    # Absolute Anchors
    metrics:vehicleHeightMeters "3.0"^^xsd:decimal ;
    metrics:frontArmorMm "100.0"^^xsd:decimal ;
    metrics:sideArmorMm "80.0"^^xsd:decimal ;
    metrics:topArmorMm "26.0"^^xsd:decimal ;
    metrics:mantletArmorMm "120.0"^^xsd:decimal ;

    # Ratios (Derived from Absolute)
    metrics:frontArmorHeightRatio "0.0333"^^xsd:decimal ;
    metrics:sideArmorHeightRatio "0.0267"^^xsd:decimal ;
    metrics:topArmorHeightRatio "0.0087"^^xsd:decimal ;
    metrics:mantletArmorHeightRatio "0.0400"^^xsd:decimal ;

    # Hierarchy Laws
    metrics:frontToSideRatio "1.25"^^xsd:decimal ;
    metrics:frontToTopRatio "3.85"^^xsd:decimal ;
    metrics:mantletToFrontRatio "1.2"^^xsd:decimal ;

    factory:usageIntent "armor_hierarchy_prior" ;
    factory:usableForGeneration "false"^^xsd:boolean ;
    factory:usableForConstraintBaseline "true"^^xsd:boolean .

eng:ArmorZoneThicknessLaw a sh:NodeShape ;
    sh:targetClass eng:ArmorBaseline_Tiger_I_V0 ;
    sh:property [
        sh:path metrics:frontToSideRatio ;
        sh:minInclusive "1.2"^^xsd:decimal ;
        sh:maxInclusive "1.5"^^xsd:decimal ;
        sh:message "Primary threat face must be noticeably thicker than lateral face."
    ] ;
    sh:property [
        sh:path metrics:frontToTopRatio ;
        sh:minInclusive "3.0"^^xsd:decimal ;
        sh:maxInclusive "4.5"^^xsd:decimal ;
        sh:message "Primary threat face must be massively thicker than secondary/roof armor."
    ] ;
    sh:property [
        sh:path metrics:mantletToFrontRatio ;
        sh:minInclusive "1.0"^^xsd:decimal ;
        sh:maxInclusive "2.0"^^xsd:decimal ;
        sh:message "Weapon apertures/mantlets must be heavily reinforced relative to the primary face."
    ] .
