@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix mud: <https://rocket-craft.com/ontology/mud#> .

# Reference Fabric Materials
mud:M_WhiteArmor rdf:type mud:Material ;
    mud:materialClass "clearcoat_armor" ;
    mud:color "#FFFFFF" ;
    mud:colorR 1.0 ; mud:colorG 1.0 ; mud:colorB 1.0 ;
    mud:roughness 0.2 ;
    mud:emissive 0.0 ;
    mud:emissionColorR 0.0 ; mud:emissionColorG 0.0 ; mud:emissionColorB 0.0 ;
    mud:metallic 0.8 ;
    mud:coat 1.0 ;
    mud:anisotropy 0.0 ;
    mud:baseColorTex "M_WhiteArmor_BaseColor.png" ;
    mud:roughnessTex "M_WhiteArmor_Roughness.png" ;
    mud:metallicTex "M_WhiteArmor_Metallic.png" ;
    mud:normalTex "M_WhiteArmor_Normal.png" .

mud:M_CyanBlade rdf:type mud:Material ;
    mud:materialClass "emissive_blade" ;
    mud:color "#00FFFF" ;
    mud:colorR 0.0 ; mud:colorG 1.0 ; mud:colorB 1.0 ;
    mud:roughness 0.1 ;
    mud:emissive 1.0 ;
    mud:emissionColorR 0.0 ; mud:emissionColorG 1.0 ; mud:emissionColorB 1.0 ;
    mud:metallic 0.9 ;
    mud:coat 0.0 ;
    mud:anisotropy 0.3 ;
    mud:baseColorTex "M_CyanBlade_BaseColor.png" ;
    mud:roughnessTex "M_CyanBlade_Roughness.png" ;
    mud:metallicTex "M_CyanBlade_Metallic.png" ;
    mud:emissiveTex "M_CyanBlade_Emissive.png" ;
    mud:normalTex "M_CyanBlade_Normal.png" .

mud:M_DarkFrame rdf:type mud:Material ;
    mud:materialClass "anodized_frame" ;
    mud:color "#222222" ;
    mud:colorR 0.1333 ; mud:colorG 0.1333 ; mud:colorB 0.1333 ;
    mud:roughness 0.8 ;
    mud:emissive 0.0 ;
    mud:emissionColorR 0.0 ; mud:emissionColorG 0.0 ; mud:emissionColorB 0.0 ;
    mud:metallic 0.1 ;
    mud:coat 0.0 ;
    mud:anisotropy 0.5 ;
    mud:baseColorTex "M_DarkFrame_BaseColor.png" ;
    mud:roughnessTex "M_DarkFrame_Roughness.png" ;
    mud:metallicTex "M_DarkFrame_Metallic.png" ;
    mud:normalTex "M_DarkFrame_Normal.png" .

mud:M_GoldVisor rdf:type mud:Material ;
    mud:materialClass "emissive_visor" ;
    mud:color "#FFD700" ;
    mud:colorR 1.0 ; mud:colorG 0.8431 ; mud:colorB 0.0 ;
    mud:roughness 0.1 ;
    mud:emissive 0.5 ;
    mud:emissionColorR 1.0 ; mud:emissionColorG 0.8431 ; mud:emissionColorB 0.0 ;
    mud:metallic 1.0 ;
    mud:coat 1.0 ;
    mud:anisotropy 0.0 ;
    mud:baseColorTex "M_GoldVisor_BaseColor.png" ;
    mud:roughnessTex "M_GoldVisor_Roughness.png" ;
    mud:metallicTex "M_GoldVisor_Metallic.png" ;
    mud:emissiveTex "M_GoldVisor_Emissive.png" ;
    mud:normalTex "M_GoldVisor_Normal.png" .

# Texture Programs (one per material; feeds texture_programs.rq)
mud:TP_WhiteArmor rdf:type mud:TextureProgram ;
    mud:targetMaterial mud:M_WhiteArmor ;
    mud:resolution 512 ;
    mud:baseColorTex "M_WhiteArmor_BaseColor.png" ;
    mud:roughnessTex "M_WhiteArmor_Roughness.png" ;
    mud:normalTex "M_WhiteArmor_Normal.png" .

mud:TP_CyanBlade rdf:type mud:TextureProgram ;
    mud:targetMaterial mud:M_CyanBlade ;
    mud:resolution 512 ;
    mud:baseColorTex "M_CyanBlade_BaseColor.png" ;
    mud:roughnessTex "M_CyanBlade_Roughness.png" ;
    mud:normalTex "M_CyanBlade_Normal.png" ;
    mud:emissiveTex "M_CyanBlade_Emissive.png" .

mud:TP_DarkFrame rdf:type mud:TextureProgram ;
    mud:targetMaterial mud:M_DarkFrame ;
    mud:resolution 512 ;
    mud:baseColorTex "M_DarkFrame_BaseColor.png" ;
    mud:roughnessTex "M_DarkFrame_Roughness.png" ;
    mud:normalTex "M_DarkFrame_Normal.png" .

mud:TP_GoldVisor rdf:type mud:TextureProgram ;
    mud:targetMaterial mud:M_GoldVisor ;
    mud:resolution 512 ;
    mud:baseColorTex "M_GoldVisor_BaseColor.png" ;
    mud:roughnessTex "M_GoldVisor_Roughness.png" ;
    mud:normalTex "M_GoldVisor_Normal.png" ;
    mud:emissiveTex "M_GoldVisor_Emissive.png" .

# Reference Fabric Primitives
mud:prim_torso_core rdf:type mud:GeometryPrimitive ;
    mud:belongsToPart mud:torso_core ;
    mud:primitiveFamily "hard_surface_shell" ;
    mud:translateX 0.0 ; mud:translateY 0.0 ; mud:translateZ 0.0 ;
    mud:scaleX 1.0 ; mud:scaleY 1.0 ; mud:scaleZ 1.0 ;
    mud:rotateX 0.0 ; mud:rotateY 0.0 ; mud:rotateZ 0.0 ;
    mud:materialBinding mud:M_WhiteArmor .

