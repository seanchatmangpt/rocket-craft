@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix antillm: <https://ggen.io/ontology/anti_llm/> .
@prefix core: <https://ggen.io/ontology/core/> .
antillm:Repository a owl:Class ; rdfs:subClassOf core:Entity ; rdfs:label "Repository" .
antillm:Crate a owl:Class ; rdfs:subClassOf core:Entity ; rdfs:label "Crate" .
antillm:File a owl:Class ; rdfs:subClassOf core:Entity ; rdfs:label "File" .
antillm:FileRange a owl:Class ; rdfs:subClassOf core:Entity ; rdfs:label "FileRange" .
antillm:Checkpoint a owl:Class ; rdfs:subClassOf core:Entity ; rdfs:label "Checkpoint" .
antillm:DiagnosticCode a owl:Class ; rdfs:subClassOf core:Entity ; rdfs:label "DiagnosticCode" .
antillm:ForbiddenImplication a owl:Class ; rdfs:subClassOf core:Entity ; rdfs:label "ForbiddenImplication" .
antillm:Diagnostic a owl:Class ; rdfs:subClassOf core:Entity ; rdfs:label "Diagnostic" .
antillm:Receipt a owl:Class ; rdfs:subClassOf core:Entity ; rdfs:label "Receipt" .
antillm:Digest a owl:Class ; rdfs:subClassOf core:Entity ; rdfs:label "Digest" .
antillm:Lsp318FeatureRow a owl:Class ; rdfs:subClassOf core:Entity ; rdfs:label "Lsp318FeatureRow" .
antillm:NegativeControlFixture a owl:Class ; rdfs:subClassOf core:Entity ; rdfs:label "NegativeControlFixture" .


# --- Source: 110_bipedal_metric_envelope_law.ttl ---
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix eng: <https://rocket-craft.com/ontology/engineering#> .
@prefix law: <https://rocket-craft.com/ontology/law#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .

# ==============================================================================
# The Metric Envelope Law (Bipedal Archetype Boundaries)
# ------------------------------------------------------------------------------
# Enforces strict metric proportionality on combinatorial generation.
# Prevents arbitrary volumetric blocks from passing bipedal morphology checks.
#
# Coordinate Frame (Origin: Pelvis Center)
# Y = Vertical Height
# X = Left/Right Span
# Z = Depth
# Unit = unit:M (Meters)
# ==============================================================================

law:BipedalMetricEnvelope a sh:NodeShape ;
    sh:targetClass law:BipedalTorso ;
    sh:property [
        sh:path ( eng:hasBodyHeight sosa:hasResult qudt:numericValue ) ;
        sh:datatype xsd:decimal ;
        sh:message "A bipedal torso must define a specific metric height in meters." ;
        sh:minCount 1 ;
    ] .

law:ShieldProportionShape a sh:NodeShape ;
    sh:targetClass law:MechaShield ;
    sh:property [
        sh:path ( eng:hasShieldHeight sosa:hasResult qudt:numericValue ) ;
        sh:datatype xsd:decimal ;
        sh:message "A shield must define its metric height in meters." ;
        sh:minCount 1 ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "REFUSE_DEFAULT_SHIELD_PROPORTION: A default shield must occupy 25%-35% of the total body height." ;
        sh:select """
            SELECT $this ?shieldHeight ?bodyHeight
            WHERE {
                $this eng:attachedTo ?mecha .
                ?mecha eng:hasBodyHeight/sosa:hasResult/qudt:numericValue ?bodyHeight .
                $this eng:hasShieldHeight/sosa:hasResult/qudt:numericValue ?shieldHeight .
                
                BIND(?shieldHeight / ?bodyHeight AS ?ratio)
                
                # Check normal shield bounds
                FILTER NOT EXISTS { $this a law:TowerShieldArchetype }
                FILTER NOT EXISTS { $this a law:SiegeShieldArchetype }
                FILTER ( ?ratio < 0.25 || ?ratio > 0.35 )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "REFUSE_TOWER_SHIELD_PROPORTION: A TowerShieldArchetype must occupy 55%-85% of total body height." ;
        sh:select """
            SELECT $this ?shieldHeight ?bodyHeight
            WHERE {
                $this a law:TowerShieldArchetype .
                $this eng:attachedTo ?mecha .
                ?mecha eng:hasBodyHeight/sosa:hasResult/qudt:numericValue ?bodyHeight .
                $this eng:hasShieldHeight/sosa:hasResult/qudt:numericValue ?shieldHeight .
                
                BIND(?shieldHeight / ?bodyHeight AS ?ratio)
                FILTER ( ?ratio < 0.55 || ?ratio > 0.85 )
            }
        """
    ] .

law:BipedalAnatomyBands a sh:NodeShape ;
    sh:targetClass law:BipedalTorso ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "ANATOMY_PARADOX: The Head Y_MIN must be structurally higher than the Torso Y_MAX." ;
        sh:select """
            SELECT $this ?headMinY ?torsoMaxY
            WHERE {
                $this eng:hasPart ?head .
                ?head a law:MechaCrown .
                
                $this eng:hasBoundingBoxYMax/sosa:hasResult/qudt:numericValue ?torsoMaxY .
                ?head eng:hasBoundingBoxYMin/sosa:hasResult/qudt:numericValue ?headMinY .
                
                FILTER ( ?headMinY < ?torsoMaxY )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "ANATOMY_PARADOX: Legs must descend below the pelvis vertical origin." ;
        sh:select """
            SELECT $this ?legMinY
            WHERE {
                $this eng:hasPart ?leg .
                ?leg a law:BipedalLeg .
                
                ?leg eng:hasBoundingBoxYMin/sosa:hasResult/qudt:numericValue ?legMinY .
                
                # Origin is pelvis center (0.0). Legs must go down into negative Y space.
                FILTER ( ?legMinY >= 0.0 )
            }
        """
    ] .


# --- Source: 114_sockets_mounts_extension.ttl ---

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix mud:  <https://rocket-craft.com/ontology/mud#> .
@prefix core: <https://rocket-craft.com/ontology/core#> .

# ─────────────────────────────────────────────────────────────────────────────
# SOCKETS AND MOUNTS EXTENSION
# ─────────────────────────────────────────────────────────────────────────────
# This ontology extension defines specialized socket and mount types required
# for the Combinatorial Engine, and enforces the "No Geometry Smuggling" rule.

# Sockets are already defined in mech_factory_mud.ttl as:
# mud:Socket a mud:PartFamily ; rdfs:label "Socket" ; core:isBounded true ; core:compilesToZST true .
# We declare the specialized socket types here.

mud:WeaponSocket a owl:Class ;
    rdfs:subClassOf mud:Socket ;
    rdfs:label "Weapon Socket" .

mud:SupportToolSocket a owl:Class ;
    rdfs:subClassOf mud:Socket ;
    rdfs:label "Support Tool Socket" .

mud:VfxSocket a owl:Class ;
    rdfs:subClassOf mud:Socket ;
    rdfs:label "VFX Socket" .

mud:CameraSocket a owl:Class ;
    rdfs:subClassOf mud:Socket ;
    rdfs:label "Camera Socket" .

mud:LoadoutMount a owl:Class ;
    rdfs:subClassOf mud:Socket ;
    rdfs:label "Loadout Mount" .

mud:DamageZoneAnchor a owl:Class ;
    rdfs:subClassOf mud:Socket ;
    rdfs:label "Damage Zone Anchor" .

# ─────────────────────────────────────────────────────────────────────────────
# SHACL VALIDATION: NO GEOMETRY SMUGGLING
# ─────────────────────────────────────────────────────────────────────────────
# "Sockets must not smuggle geometry."
# We enforce this by ensuring no mud:GeometryPrimitive points to a Socket
# using mud:belongsToPart.

mud:SocketGeometrySmugglingShape a sh:NodeShape ;
    sh:targetClass mud:Socket ;
    sh:property [
        sh:path [ sh:inversePath mud:belongsToPart ] ;
        sh:maxCount 0 ;
        sh:message "Sockets must not smuggle geometry. A mud:GeometryPrimitive must not have mud:belongsToPart pointing to a mud:Socket."
    ] ;
    sh:property [
        sh:path mud:hasGeometry ;
        sh:maxCount 0 ;
        sh:message "Sockets must not smuggle geometry. mud:hasGeometry is forbidden on any Socket."
    ] ;
    sh:property [
        sh:path core:mesh ;
        sh:maxCount 0 ;
        sh:message "Sockets must not smuggle geometry. core:mesh is forbidden on any Socket."
    ] .



# --- Source: 115_destruction_ontology.ttl ---
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
# =========================================================
# Destruction Ontology
# =========================================================

@prefix core: <https://ggen.io/ontology/core/> .
@prefix ds: <https://ggen.io/ontology/destruction/> .
@prefix mud: <https://rocket-craft.com/ontology/mud#> .
ds:DestructionOntology a owl:Ontology ;
    rdfs:label "Destruction States Ontology" ;
    rdfs:comment "Combinatorial Destruction States: armor break states, exposed frame states, damaged material states, detached panel declarations, damage-zone transitions, VFX socket bindings." ;
    owl:imports <https://ggen.io/ontology/core/> .
# --- BASE DESTRUCTION STATE ---
ds:DestructionState a owl:Class ;
    rdfs:subClassOf core:Typestate ;
    rdfs:label "Destruction State" ;
    rdfs:comment "A branchless typestate defining deterministic destruction geometry and VFX triggers." .
# --- 1. ARMOR BREAK STATES ---
ds:ArmorBreakState a owl:Class ;
    rdfs:subClassOf ds:DestructionState ;
    rdfs:label "Armor Break State" ;
    rdfs:comment "Admitted topology for fractured or completely broken armor plates." ;
    core:compilesToZST true .
# --- 2. EXPOSED FRAME STATES ---
ds:ExposedFrameState a owl:Class ;
    rdfs:subClassOf ds:DestructionState ;
    rdfs:label "Exposed Frame State" ;
    rdfs:comment "Admitted topology indicating the mechanical frame is exposed due to destroyed armor." ;
    core:compilesToZST true .
# --- 3. DAMAGED MATERIAL STATES ---
ds:DamagedMaterialState a owl:Class ;
    rdfs:subClassOf ds:DestructionState ;
    rdfs:label "Damaged Material State" ;
    rdfs:comment "Admitted material shader typestate switching, e.g., scorched or ablated surfaces." ;
    core:compilesToZST true .
# --- 4. DETACHED PANEL DECLARATIONS ---
ds:DetachedPanelDeclaration a owl:Class ;
    rdfs:subClassOf ds:DestructionState ;
    rdfs:label "Detached Panel Declaration" ;
    rdfs:comment "Authority declaration that a panel has fully detached from its socket." ;
    core:compilesToZST true .
# --- 5. DAMAGE-ZONE TRANSITIONS ---
ds:DamageZoneTransition a owl:Class ;
    rdfs:subClassOf ds:DestructionState ;
    rdfs:label "Damage Zone Transition" ;
    rdfs:comment "Branchless transition boundary between varying states of structural integrity." ;
    core:compilesToZST true .
# --- 6. VFX SOCKET BINDINGS ---
ds:VFXSocketBinding a owl:Class ;
    rdfs:subClassOf ds:DestructionState ;
    rdfs:label "VFX Socket Binding" ;
    rdfs:comment "Deterministic binding point for peer-projection VFX (e.g., spark emitters, smoke)." ;
    core:compilesToZST true .
# --- 7. SEMANTIC LOD MAPPINGS ---
# Map the new high-poly USD files (1.8MB) back to the byte-class compact network payloads.
mud:hasNetworkPayload a owl:ObjectProperty ;
    rdfs:label "has Network Payload" ;
    rdfs:comment "Maps a visual asset or part to its authoritative byte-class network payload." .
mud:ue4TargetSurface a owl:DatatypeProperty ;
    rdfs:label "UE4 Target Surface" ;
    rdfs:comment "The target USD or UE4 surface for the part." .
mud:torso_core 
    mud:ue4TargetSurface "SM_Torso.usda" ;
    mud:hasNetworkPayload mud:DamageClass, mud:HeatClass, mud:StressClass, mud:FatigueClass ;
    mud:lodClass "CROWN" .
mud:head_unit 
    mud:ue4TargetSurface "SM_Head.usda" ;
    mud:hasNetworkPayload mud:DamageClass, mud:HeatClass ;
    mud:lodClass "CROWN" .
mud:arm_left 
    mud:ue4TargetSurface "SM_Limb_Left.usda" ;
    mud:hasNetworkPayload mud:DamageClass, mud:StressClass, mud:HeatClass, mud:SocketHealthClass ;
    mud:lodClass "PRIMARY" .
mud:arm_right 
    mud:ue4TargetSurface "SM_Limb_Right.usda" ;
    mud:hasNetworkPayload mud:DamageClass, mud:StressClass, mud:HeatClass, mud:SocketHealthClass ;
    mud:lodClass "PRIMARY" .
mud:leg_left 
    mud:ue4TargetSurface "SM_Limb_Left.usda" ;
    mud:hasNetworkPayload mud:DamageClass, mud:StressClass, mud:HeatClass, mud:SocketHealthClass ;
    mud:lodClass "PRIMARY" .
mud:leg_right 
    mud:ue4TargetSurface "SM_Limb_Right.usda" ;
    mud:hasNetworkPayload mud:DamageClass, mud:StressClass, mud:HeatClass, mud:SocketHealthClass ;
    mud:lodClass "PRIMARY" .
mud:wing_root_left 
    mud:ue4TargetSurface "SM_WingArray_Left.usda" ;
    mud:hasNetworkPayload mud:DamageClass, mud:StressClass ;
    mud:lodClass "SECONDARY" .
mud:wing_root_right 
    mud:ue4TargetSurface "SM_WingArray_Right.usda" ;
    mud:hasNetworkPayload mud:DamageClass, mud:StressClass ;
    mud:lodClass "SECONDARY" .
mud:blade_left 
    mud:ue4TargetSurface "SM_Blade_Left.usda" ;
    mud:hasNetworkPayload mud:DamageClass, mud:FatigueClass ;
    mud:lodClass "PRIMARY" .
mud:blade_right 
    mud:ue4TargetSurface "SM_Blade_Right.usda" ;
    mud:hasNetworkPayload mud:DamageClass, mud:FatigueClass ;
    mud:lodClass "PRIMARY" .
mud:backpack_core 
    mud:ue4TargetSurface "SM_Loadout.usda" ;
    mud:hasNetworkPayload mud:DamageClass, mud:HeatClass, mud:FatigueClass ;
    mud:lodClass "SECONDARY" .


# --- Source: 116_metric_morphology_bands.ttl ---
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix eng: <https://rocket-craft.com/ontology/engineering#> .
@prefix law: <https://rocket-craft.com/ontology/law#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .

# ==============================================================================
# 116 - Metric Morphology Bands (Graph Law, extends 110)
# ------------------------------------------------------------------------------
# Morphology is GRAPH LAW: a part's vertical envelope is a ratio of body height
# (unit-free). The graph defines the robot; the render cannot. A "huge UFO disc"
# is REFUSED here by metric band law, not discovered later in UE4/Playwright.
#
# Bands are T3_archetype_estimate (bipedal winged mecha). Ratios are unit-free;
# the absolute meter anchor (eng:hasBodyHeight) only drives human-readable
# derived envelopes. Vertical axis convention follows 110 (eng:hasBoundingBoxY*).
# ==============================================================================

<https://rocket-craft.com/ontology/law#116_metric_morphology_bands>
    a owl:Ontology ;
    rdfs:label "Metric Morphology Bands"@en ;
    rdfs:comment "Per-part vertical envelope bands as ratio-of-body-height; archetype shield exception classes."@en ;
    owl:imports <https://rocket-craft.com/ontology/law#> .

# --- Archetype exception classes (referenced by 110's shield shapes) ----------
law:TowerShieldArchetype a owl:Class ;
    rdfs:subClassOf law:MechaShield ;
    rdfs:label "Tower Shield Archetype"@en ;
    rdfs:comment "Exception class: shield may occupy 55%-85% of body height."@en .

law:SiegeShieldArchetype a owl:Class ;
    rdfs:subClassOf law:MechaShield ;
    rdfs:label "Siege Shield Archetype"@en ;
    rdfs:comment "Exception class: heavy emplacement shield, exempt from default proportion."@en .

law:MobileBarricadeArchetype a owl:Class ;
    rdfs:subClassOf law:MechaShield ;
    rdfs:label "Mobile Barricade Archetype"@en ;
    rdfs:comment "Exception class: barricade-scale shield (0.85-1.10 of body height)."@en .

law:TransformationShieldArchetype a owl:Class ;
    rdfs:subClassOf law:MechaShield ;
    rdfs:label "Transformation Shield Archetype"@en ;
    rdfs:comment "Exception class: transformable shield permitted to reach 0.85-1.10 of body height."@en .

# --- New morphology vocabulary (declared here) -------------------------------
law:MorphologyBand a owl:Class ;
    rdfs:label "Morphology Band"@en ;
    rdfs:comment "A declarative [min,max] height-ratio band for a part class (unit-free)."@en .

law:appliesToPartClass a owl:ObjectProperty ;
    rdfs:domain law:MorphologyBand ;
    rdfs:label "applies to part class"@en .

law:bandMinRatio a owl:DatatypeProperty ; rdfs:domain law:MorphologyBand ; rdfs:range xsd:decimal .
law:bandMaxRatio a owl:DatatypeProperty ; rdfs:domain law:MorphologyBand ; rdfs:range xsd:decimal .
law:bandMinXSpanRatio a owl:DatatypeProperty ; rdfs:domain law:MorphologyBand ; rdfs:range xsd:decimal .
law:bandMaxXSpanRatio a owl:DatatypeProperty ; rdfs:domain law:MorphologyBand ; rdfs:range xsd:decimal .

eng:hasBoundingBoxYMax a owl:ObjectProperty ; rdfs:label "has bounding box Y max"@en .

# --- Part morphology classes -------------------------------------------------
law:BipedalLimb a owl:Class ;
    rdfs:subClassOf eng:MechaPart ;
    rdfs:label "Bipedal Limb"@en .

# The torso SEGMENT part (distinct from law:BipedalTorso, which 110 uses as the
# whole-body root carrying eng:hasBodyHeight + eng:hasPart anatomy bands).
law:TorsoSegment a owl:Class ;
    rdfs:subClassOf eng:MechaPart ;
    rdfs:label "Torso Segment"@en .

law:WingArray a owl:Class ;
    rdfs:subClassOf eng:MechaPart ;
    rdfs:label "Wing Array"@en .

# Ensure the morphology part classes are reachable as eng:MechaPart so the
# generic PartHeightBandShape (sh:targetClass eng:MechaPart) targets them.
law:MechaCrown   rdfs:subClassOf eng:MechaPart .
law:BipedalTorso rdfs:subClassOf eng:MechaPart .
law:BipedalLeg   rdfs:subClassOf eng:MechaPart .

law:MechaWeapon a owl:Class ;
    rdfs:subClassOf eng:MechaPart ;
    rdfs:label "Mecha Weapon"@en .

# --- QUDT-typed ratio bands (T3_archetype_estimate) --------------------------
# Each band: a declarative record of [min,max] height-ratio for a part class.
law:HeadHeightBand a law:MorphologyBand ;
    law:appliesToPartClass law:MechaCrown ;
    law:bandMinRatio "0.0800"^^xsd:decimal ;
    law:bandMaxRatio "0.1500"^^xsd:decimal ;
    qudt:hasQuantityKind qudt:DimensionlessRatio .

law:TorsoHeightBand a law:MorphologyBand ;
    law:appliesToPartClass law:TorsoSegment ;
    law:bandMinRatio "0.3000"^^xsd:decimal ;
    law:bandMaxRatio "0.4500"^^xsd:decimal ;
    qudt:hasQuantityKind qudt:DimensionlessRatio .

law:LimbHeightBand a law:MorphologyBand ;
    law:appliesToPartClass law:BipedalLimb ;
    law:bandMinRatio "0.5500"^^xsd:decimal ;
    law:bandMaxRatio "0.8500"^^xsd:decimal ;
    qudt:hasQuantityKind qudt:DimensionlessRatio .

law:LegHeightBand a law:MorphologyBand ;
    law:appliesToPartClass law:BipedalLeg ;
    law:bandMinRatio "0.5500"^^xsd:decimal ;
    law:bandMaxRatio "0.8500"^^xsd:decimal ;
    qudt:hasQuantityKind qudt:DimensionlessRatio .

law:WingSpanBand a law:MorphologyBand ;
    law:appliesToPartClass law:WingArray ;
    law:bandMinXSpanRatio "0.30"^^xsd:decimal ;
    law:bandMaxXSpanRatio "1.20"^^xsd:decimal ;
    law:bandMinRatio "0.4000"^^xsd:decimal ;
    law:bandMaxRatio "0.9000"^^xsd:decimal ;
    qudt:hasQuantityKind qudt:DimensionlessRatio .

law:WeaponHeightBand a law:MorphologyBand ;
    law:appliesToPartClass law:MechaWeapon ;
    law:bandMinRatio "0.1000"^^xsd:decimal ;
    law:bandMaxRatio "0.6000"^^xsd:decimal ;
    qudt:hasQuantityKind qudt:DimensionlessRatio .

# Shield tiers (declared, enforced via 110 + extension below)
law:ShieldNormalTier   a law:MorphologyBand ; law:bandMinRatio "0.25"^^xsd:decimal ; law:bandMaxRatio "0.35"^^xsd:decimal .
law:ShieldLargeTier    a law:MorphologyBand ; law:bandMinRatio "0.35"^^xsd:decimal ; law:bandMaxRatio "0.55"^^xsd:decimal .
law:ShieldTowerTier    a law:MorphologyBand ; law:bandMinRatio "0.55"^^xsd:decimal ; law:bandMaxRatio "0.85"^^xsd:decimal .
law:ShieldExceptionTier a law:MorphologyBand ; law:bandMinRatio "0.85"^^xsd:decimal ; law:bandMaxRatio "1.10"^^xsd:decimal .

# ==============================================================================
# SHACL refusal shapes (mirror 110's sh:SPARQLConstraint style)
# ==============================================================================

# Generic per-part vertical-band refusal. A part bound to a MorphologyBand whose
# measured height ratio falls outside [min,max] is REFUSED.
law:PartHeightBandShape a sh:NodeShape ;
    sh:targetClass eng:MechaPart ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "REFUSE_PART_HEIGHT_BAND: part height ratio falls outside its declared morphology band." ;
        sh:select """
            SELECT $this ?ratio ?lo ?hi
            WHERE {
                $this a ?pc .
                ?band law:appliesToPartClass ?pc .
                ?band law:bandMinRatio ?lo .
                ?band law:bandMaxRatio ?hi .

                $this eng:attachedTo ?mecha .
                ?mecha eng:hasBodyHeight/sosa:hasResult/qudt:numericValue ?bodyHeight .
                $this eng:hasBoundingBoxYMin/sosa:hasResult/qudt:numericValue ?ymin .
                $this eng:hasBoundingBoxYMax/sosa:hasResult/qudt:numericValue ?ymax .

                BIND( ( ?ymax - ?ymin ) / ?bodyHeight AS ?ratio )
                FILTER ( ?ratio < ?lo || ?ratio > ?hi )
            }
        """
    ] .

# UFO-disc / oversized-shield refusal: a shield at exception scale (>0.85) is
# only lawful WITH a declared *ShieldArchetype. Otherwise REFUSE.
law:ShieldExceptionGateShape a sh:NodeShape ;
    sh:targetClass law:MechaShield ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "REFUSE_DEFAULT_SHIELD_PROPORTION: a shield exceeding 85% of body height requires a declared *ShieldArchetype exception class." ;
        sh:select """
            SELECT $this ?ratio
            WHERE {
                $this eng:attachedTo ?mecha .
                ?mecha eng:hasBodyHeight/sosa:hasResult/qudt:numericValue ?bodyHeight .
                $this eng:hasShieldHeight/sosa:hasResult/qudt:numericValue ?shieldHeight .
                BIND( ?shieldHeight / ?bodyHeight AS ?ratio )

                FILTER ( ?ratio > 0.85 )
                FILTER NOT EXISTS { $this a law:TowerShieldArchetype }
                FILTER NOT EXISTS { $this a law:SiegeShieldArchetype }
                FILTER NOT EXISTS { $this a law:MobileBarricadeArchetype }
                FILTER NOT EXISTS { $this a law:TransformationShieldArchetype }
            }
        """
    ] .


# --- Source: 117_reference_fabric_metric_binding.ttl ---
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix eng: <https://rocket-craft.com/ontology/engineering#> .
@prefix law: <https://rocket-craft.com/ontology/law#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix rf: <https://rocket-craft.com/asset/reference_fabric_001#> .

# ==============================================================================
# 117 - Reference Fabric Metric Binding
# ------------------------------------------------------------------------------
# Binds the flagship mech (reference_fabric_001) to the metric frame of 110/116.
# The per-geometry measured envelopes (Y_MIN/Y_MAX numericValues) are supplied
# at gate time by scripts/verify_metric_morphology.py; THIS file fixes the
# class typings, the parent assembly composition, and the body-height anchor.
#
# This flagship has NO shield -> 110/116 shield shapes pass vacuously (correct).
# ==============================================================================

<https://rocket-craft.com/ontology/law#117_reference_fabric_metric_binding>
    a owl:Ontology ;
    rdfs:label "Reference Fabric Metric Binding"@en ;
    owl:imports <https://rocket-craft.com/ontology/law#116_metric_morphology_bands> .

# --- The mech instance + canonical body-height anchor ------------------------
# 18.0 m is a defensible flagship anchor. Morphology bands are RATIO-based and
# therefore unit-free; this absolute value only feeds human-readable derived
# envelopes. The gate re-measures body height from geometry and rebinds it.
rf:ReferenceFabric_001 a law:BipedalTorso ;
    rdfs:label "Reference Fabric 001 (flagship mech)"@en ;
    eng:hasBodyHeight [
        a sosa:Observation ;
        sosa:hasResult [ qudt:numericValue "18.0"^^xsd:decimal ; qudt:unit unit:M ]
    ] ;
    eng:hasPart rf:SM_Torso , rf:SM_Head ,
                rf:SM_Limb_Left , rf:SM_Limb_Right ,
                rf:SM_WingArray_Left , rf:SM_WingArray_Right ,
                rf:SM_Blade_Left , rf:SM_Blade_Right .

# --- Part class typings (graph defines the robot) ----------------------------
rf:SM_Head           a law:MechaCrown ;   eng:attachedTo rf:ReferenceFabric_001 .
rf:SM_Torso          a law:TorsoSegment ;  eng:attachedTo rf:ReferenceFabric_001 .
rf:SM_Limb_Left      a law:BipedalLeg , law:BipedalLimb ; eng:attachedTo rf:ReferenceFabric_001 .
rf:SM_Limb_Right     a law:BipedalLeg , law:BipedalLimb ; eng:attachedTo rf:ReferenceFabric_001 .
rf:SM_WingArray_Left  a law:WingArray ;   eng:attachedTo rf:ReferenceFabric_001 .
rf:SM_WingArray_Right a law:WingArray ;   eng:attachedTo rf:ReferenceFabric_001 .
rf:SM_Blade_Left     a law:MechaWeapon ;  eng:attachedTo rf:ReferenceFabric_001 .
rf:SM_Blade_Right    a law:MechaWeapon ;  eng:attachedTo rf:ReferenceFabric_001 .


# --- Source: 118_limb_anatomical_joints.ttl ---
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mud: <https://rocket-craft.com/ontology/mud#> .

# Sockets for anatomical connection (must not contain mesh payloads)
mud:Socket_Elbow_Left rdf:type mud:Socket ;
    rdfs:label "Left Elbow Socket" .

mud:Socket_Wrist_Left rdf:type mud:Socket ;
    rdfs:label "Left Wrist Socket" .

mud:Socket_Knee_Left rdf:type mud:Socket ;
    rdfs:label "Left Knee Socket" .

mud:Socket_Ankle_Left rdf:type mud:Socket ;
    rdfs:label "Left Ankle Socket" .

mud:Socket_Elbow_Right rdf:type mud:Socket ;
    rdfs:label "Right Elbow Socket" .

mud:Socket_Wrist_Right rdf:type mud:Socket ;
    rdfs:label "Right Wrist Socket" .

mud:Socket_Knee_Right rdf:type mud:Socket ;
    rdfs:label "Right Knee Socket" .

mud:Socket_Ankle_Right rdf:type mud:Socket ;
    rdfs:label "Right Ankle Socket" .

# Pegs representing connection ends
mud:Peg_Forearm_Elbow_Left rdf:type mud:Peg ;
    rdfs:label "Left Forearm Elbow Peg" ;
    mud:insertsIntoSocket mud:Socket_Elbow_Left .

mud:Peg_Hand_Wrist_Left rdf:type mud:Peg ;
    rdfs:label "Left Hand Wrist Peg" ;
    mud:insertsIntoSocket mud:Socket_Wrist_Left .

mud:Peg_Shin_Knee_Left rdf:type mud:Peg ;
    rdfs:label "Left Shin Knee Peg" ;
    mud:insertsIntoSocket mud:Socket_Knee_Left .

mud:Peg_Foot_Ankle_Left rdf:type mud:Peg ;
    rdfs:label "Left Foot Ankle Peg" ;
    mud:insertsIntoSocket mud:Socket_Ankle_Left .

mud:Peg_Forearm_Elbow_Right rdf:type mud:Peg ;
    rdfs:label "Right Forearm Elbow Peg" ;
    mud:insertsIntoSocket mud:Socket_Elbow_Right .

mud:Peg_Hand_Wrist_Right rdf:type mud:Peg ;
    rdfs:label "Right Hand Wrist Peg" ;
    mud:insertsIntoSocket mud:Socket_Wrist_Right .

mud:Peg_Shin_Knee_Right rdf:type mud:Peg ;
    rdfs:label "Right Shin Knee Peg" ;
    mud:insertsIntoSocket mud:Socket_Knee_Right .

mud:Peg_Foot_Ankle_Right rdf:type mud:Peg ;
    rdfs:label "Right Foot Ankle Peg" ;
    mud:insertsIntoSocket mud:Socket_Ankle_Right .


# --- Source: 120_morphology_purity_law.ttl ---
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix eng: <https://rocket-craft.com/ontology/engineering#> .
@prefix law: <https://rocket-craft.com/ontology/law#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix mud: <https://rocket-craft.com/ontology/mud#> .

law:MorphologyPurityOntology a owl:Ontology ;
    rdfs:label "Morphology Purity and Provenance Law"@en ;
    rdfs:comment "Enforces that all geometric morphology decisions, subdivision density classes, scale bands, material bindings, and units are derived strictly from source law (TTL/SPARQL), refusing any hardcoded Python control surface code."@en .

# --- Properties for Morphology replaced facts ---
law:hasSubdivisionDensity rdf:type owl:DatatypeProperty ;
    rdfs:domain mud:GeometryPrimitive ;
    rdfs:range xsd:integer ;
    qudt:hasQuantityKind qudt:DimensionlessRatio ;
    rdfs:label "has subdivision density"@en .

law:hasArmorDensityBand rdf:type owl:DatatypeProperty ;
    rdfs:domain mud:GeometryPrimitive ;
    rdfs:range xsd:string ;
    rdfs:label "has armor density band"@en .

law:hasCurvatureSweepClass rdf:type owl:DatatypeProperty ;
    rdfs:domain mud:GeometryPrimitive ;
    rdfs:range xsd:string ;
    rdfs:label "has curvature sweep class"@en .

law:hasMaterialZoneBinding rdf:type owl:ObjectProperty ;
    rdfs:domain mud:GeometryPrimitive ;
    rdfs:range mud:Material ;
    rdfs:label "has material zone binding"@en .

law:hasBladeScaleMin rdf:type owl:DatatypeProperty ;
    rdfs:domain mud:GeometryPrimitive ;
    rdfs:range xsd:decimal ;
    qudt:hasQuantityKind qudt:Length ;
    qudt:unit unit:M ;
    rdfs:label "has blade scale min"@en .

law:hasBladeScaleMax rdf:type owl:DatatypeProperty ;
    rdfs:domain mud:GeometryPrimitive ;
    rdfs:range xsd:decimal ;
    qudt:hasQuantityKind qudt:Length ;
    qudt:unit unit:M ;
    rdfs:label "has blade scale max"@en .

law:hasEdgeCount rdf:type owl:DatatypeProperty ;
    rdfs:domain mud:GeometryPrimitive ;
    rdfs:range xsd:integer ;
    qudt:hasQuantityKind qudt:DimensionlessRatio ;
    rdfs:label "has edge count"@en .

law:hasSocketAttachment rdf:type owl:ObjectProperty ;
    rdfs:domain mud:GeometryPrimitive ;
    rdfs:range mud:Socket ;
    rdfs:label "has socket attachment"@en .

# Define Socket None if not present
mud:Socket_None rdf:type mud:Socket ;
    rdfs:label "No Socket Attachment" .

# --- SHACL Refusal Shapes ---

# 1. Refuse hardcoded Python morphology / magic geometry constants not backed by TTL
# Every GeometryPrimitive MUST have all its parameters explicitly declared in the TTL.
law:GeometryPurityShape a sh:NodeShape ;
    sh:targetClass mud:GeometryPrimitive ;
    sh:property [
        sh:path law:hasSubdivisionDensity ;
        sh:minCount 1 ;
        sh:datatype xsd:integer ;
        sh:message "REFUSE_MAGIC_GEOMETRY: Geometry primitive lacks an explicit subdivision density class in TTL." ;
    ] ;
    sh:property [
        sh:path law:hasMaterialZoneBinding ;
        sh:minCount 1 ;
        sh:message "REFUSE_MAGIC_GEOMETRY: Geometry primitive lacks a material zone binding in TTL." ;
    ] ;
    sh:property [
        sh:path mud:translateX ;
        sh:minCount 1 ;
        sh:datatype xsd:float ;
        sh:message "REFUSE_MAGIC_GEOMETRY: Translation X must be defined as an xsd:float in TTL." ;
    ] ;
    sh:property [
        sh:path mud:translateY ;
        sh:minCount 1 ;
        sh:datatype xsd:float ;
        sh:message "REFUSE_MAGIC_GEOMETRY: Translation Y must be defined as an xsd:float in TTL." ;
    ] ;
    sh:property [
        sh:path mud:translateZ ;
        sh:minCount 1 ;
        sh:datatype xsd:float ;
        sh:message "REFUSE_MAGIC_GEOMETRY: Translation Z must be defined as an xsd:float in TTL." ;
    ] ;
    sh:property [
        sh:path mud:scaleX ;
        sh:minCount 1 ;
        sh:datatype xsd:float ;
        sh:message "REFUSE_MAGIC_GEOMETRY: Scale X must be defined as an xsd:float in TTL." ;
    ] ;
    sh:property [
        sh:path mud:scaleY ;
        sh:minCount 1 ;
        sh:datatype xsd:float ;
        sh:message "REFUSE_MAGIC_GEOMETRY: Scale Y must be defined as an xsd:float in TTL." ;
    ] ;
    sh:property [
        sh:path mud:scaleZ ;
        sh:minCount 1 ;
        sh:datatype xsd:float ;
        sh:message "REFUSE_MAGIC_GEOMETRY: Scale Z must be defined as an xsd:float in TTL." ;
    ] ;
    sh:property [
        sh:path mud:rotateX ;
        sh:minCount 1 ;
        sh:datatype xsd:float ;
        sh:message "REFUSE_MAGIC_GEOMETRY: Rotation X must be defined as an xsd:float in TTL." ;
    ] ;
    sh:property [
        sh:path mud:rotateY ;
        sh:minCount 1 ;
        sh:datatype xsd:float ;
        sh:message "REFUSE_MAGIC_GEOMETRY: Rotation Y must be defined as an xsd:float in TTL." ;
    ] ;
    sh:property [
        sh:path mud:rotateZ ;
        sh:minCount 1 ;
        sh:datatype xsd:float ;
        sh:message "REFUSE_MAGIC_GEOMETRY: Rotation Z must be defined as an xsd:float in TTL." ;
    ] ;
    sh:property [
        sh:path law:hasEdgeCount ;
        sh:minCount 1 ;
        sh:datatype xsd:integer ;
        sh:message "REFUSE_MAGIC_GEOMETRY: Edge count must be defined as an xsd:integer in TTL." ;
    ] ;
    sh:property [
        sh:path law:hasSocketAttachment ;
        sh:minCount 1 ;
        sh:message "REFUSE_MAGIC_GEOMETRY: Socket attachment must be defined in TTL." ;
    ] ;
    sh:property [
        sh:path law:hasCurvatureSweepClass ;
        sh:minCount 1 ;
        sh:message "REFUSE_MAGIC_GEOMETRY: Curvature sweep class must be defined in TTL." ;
    ] ;
    sh:property [
        sh:path law:hasArmorDensityBand ;
        sh:minCount 1 ;
        sh:message "REFUSE_MAGIC_GEOMETRY: Armor density band must be defined in TTL." ;
    ] .

# 2. Refuse generated USD whose dimensions lack source-law provenance / refuse density escalation not selected by SPARQL
law:DensityEscalationShape a sh:NodeShape ;
    sh:targetClass mud:GeometryPrimitive ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "REFUSE_DENSITY_ESCALATION: Subdivision density exceeds the maximum permitted density class (32)." ;
        sh:select """
            SELECT $this ?density
            WHERE {
                $this law:hasSubdivisionDensity ?density .
                FILTER ( ?density > 32 )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "REFUSE_DENSITY_ESCALATION: Subdivision density exceeds permitted band density." ;
        sh:select """
            SELECT $this ?density ?band
            WHERE {
                $this law:hasSubdivisionDensity ?density .
                $this law:hasArmorDensityBand ?band .
                FILTER (
                    ( ?band = "law:HighDensityArmor" && ?density > 32 ) ||
                    ( ?band = "law:MediumDensityArmor" && ?density > 16 ) ||
                    ( ?band = "law:LowDensityArmor" && ?density > 8 )
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "REFUSE_PROVENANCE_VIOLATION: Primitive scale exceeds the permitted scale bands defined in source law." ;
        sh:select """
            SELECT $this ?scaleX ?scaleMax
            WHERE {
                $this mud:scaleX ?scaleX .
                $this law:hasBladeScaleMax ?scaleMax .
                FILTER ( xsd:decimal(?scaleX) > ?scaleMax )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "REFUSE_PROVENANCE_VIOLATION: Primitive scale is less than the minimum permitted scale bands defined in source law." ;
        sh:select """
            SELECT $this ?scaleX ?scaleMin
            WHERE {
                $this mud:scaleX ?scaleX .
                $this law:hasBladeScaleMin ?scaleMin .
                FILTER ( xsd:decimal(?scaleX) < ?scaleMin )
            }
        """
    ] .


# --- Source: 121_kinematic_connectivity_law.ttl ---
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix eng: <https://rocket-craft.com/ontology/engineering#> .
@prefix law: <https://rocket-craft.com/ontology/law#> .
@prefix ro: <http://purl.obolibrary.org/obo/> .
@prefix rf: <https://rocket-craft.com/asset/reference_fabric_001#> .

# ==============================================================================
# 121 - Kinematic Connectivity Law (assembly coherence, NOT per-part size)
# ------------------------------------------------------------------------------
# The metric-morphology gate (110/116/117) measures per-part bounding-box RATIOS.
# It is blind to PLACEMENT: a mech whose parts float apart with large gaps (an
# "exploded blockout") still passes every ratio band. This law closes that hole.
#
# Connectivity is GRAPH LAW grounded in PUBLIC relations from the OBO Relations
# Ontology (RO) and Basic Formal Ontology (BFO):
#   ro:connected_to  = http://purl.obolibrary.org/obo/RO_0002170
#   bfo:part_of      = http://purl.obolibrary.org/obo/BFO_0000050
# law:articulatesWith is a sub-property of ro:connected_to for kinematic joints
# (URDF/CORA-style link+joint tree). A coherent bipedal figure is a single
# connected component: every non-root link reaches the Torso root through joints,
# and each joint's child link is in metric CONTACT with its parent link.
# ==============================================================================

<https://rocket-craft.com/ontology/law#121_kinematic_connectivity_law>
    a owl:Ontology ;
    rdfs:label "Kinematic Connectivity Law"@en ;
    rdfs:comment "Assembly-coherence law: bipedal kinematic tree rooted at the torso, grounded in OBO RO connected_to / BFO part_of; refuses floating or disconnected parts."@en ;
    owl:imports <https://rocket-craft.com/ontology/law#117_reference_fabric_metric_binding> .

# --- Public relations (declared by their real IRIs) --------------------------
ro:RO_0002170 a owl:ObjectProperty ;
    rdfs:label "connected_to"@en ;
    rdfs:comment "OBO Relations Ontology: c connected_to c' (mereotopological contact)."@en .

ro:BFO_0000050 a owl:ObjectProperty ;
    rdfs:label "part_of"@en ;
    rdfs:comment "Basic Formal Ontology: part_of."@en .

# --- Kinematic vocabulary (URDF/CORA-style link + joint tree) ----------------
law:KinematicLink a owl:Class ;
    rdfs:label "Kinematic Link"@en ;
    rdfs:comment "A rigid body in the kinematic tree (a flagship mech part)."@en .

law:Joint a owl:Class ;
    rdfs:label "Joint"@en ;
    rdfs:comment "A kinematic joint connecting a parent link to a child link."@en .

law:RootLink a owl:Class ;
    rdfs:subClassOf law:KinematicLink ;
    rdfs:label "Root Link"@en ;
    rdfs:comment "The root of the kinematic tree (the torso). Has no parent joint."@en .

law:articulatesWith a owl:ObjectProperty ;
    rdfs:subPropertyOf ro:RO_0002170 ;
    rdfs:label "articulates with"@en ;
    rdfs:comment "Kinematic joint connectivity; a sub-property of ro:connected_to. parentLink articulatesWith childLink."@en .

law:parentLink a owl:ObjectProperty ;
    rdfs:domain law:Joint ; rdfs:range law:KinematicLink ;
    rdfs:label "parent link"@en .

law:childLink a owl:ObjectProperty ;
    rdfs:domain law:Joint ; rdfs:range law:KinematicLink ;
    rdfs:label "child link"@en .

# --- The flagship bipedal kinematic tree (rooted at the Torso) ----------------
# Every flagship part is a KinematicLink; the Torso is the RootLink. Joints form
# a tree:  Torso -> Head, Limb_L, Limb_R, Wing_L, Wing_R ;  Limb_* -> Blade_*.
rf:SM_Torso          a law:RootLink, law:KinematicLink .
rf:SM_Head           a law:KinematicLink .
rf:SM_Limb_Left      a law:KinematicLink .
rf:SM_Limb_Right     a law:KinematicLink .
rf:SM_WingArray_Left  a law:KinematicLink .
rf:SM_WingArray_Right a law:KinematicLink .
rf:SM_Blade_Left     a law:KinematicLink .
rf:SM_Blade_Right    a law:KinematicLink .

rf:joint_neck a law:Joint ;
    rdfs:label "neck_joint"@en ;
    law:parentLink rf:SM_Torso ; law:childLink rf:SM_Head ;
    law:articulatesWith rf:SM_Head .
rf:SM_Torso law:articulatesWith rf:SM_Head .

rf:joint_shoulder_left a law:Joint ;
    rdfs:label "shoulder_mount_left"@en ;
    law:parentLink rf:SM_Torso ; law:childLink rf:SM_Limb_Left ;
    law:articulatesWith rf:SM_Limb_Left .
rf:SM_Torso law:articulatesWith rf:SM_Limb_Left .

rf:joint_shoulder_right a law:Joint ;
    rdfs:label "shoulder_mount_right"@en ;
    law:parentLink rf:SM_Torso ; law:childLink rf:SM_Limb_Right ;
    law:articulatesWith rf:SM_Limb_Right .
rf:SM_Torso law:articulatesWith rf:SM_Limb_Right .

rf:joint_wing_mount_left a law:Joint ;
    rdfs:label "wing_mount_left"@en ;
    law:parentLink rf:SM_Torso ; law:childLink rf:SM_WingArray_Left ;
    law:articulatesWith rf:SM_WingArray_Left .
rf:SM_Torso law:articulatesWith rf:SM_WingArray_Left .

rf:joint_wing_mount_right a law:Joint ;
    rdfs:label "wing_mount_right"@en ;
    law:parentLink rf:SM_Torso ; law:childLink rf:SM_WingArray_Right ;
    law:articulatesWith rf:SM_WingArray_Right .
rf:SM_Torso law:articulatesWith rf:SM_WingArray_Right .

rf:joint_weapon_left a law:Joint ;
    rdfs:label "weapon_joint_left"@en ;
    law:parentLink rf:SM_Limb_Left ; law:childLink rf:SM_Blade_Left ;
    law:articulatesWith rf:SM_Blade_Left .
rf:SM_Limb_Left law:articulatesWith rf:SM_Blade_Left .

rf:joint_weapon_right a law:Joint ;
    rdfs:label "weapon_joint_right"@en ;
    law:parentLink rf:SM_Limb_Right ; law:childLink rf:SM_Blade_Right ;
    law:articulatesWith rf:SM_Blade_Right .
rf:SM_Limb_Right law:articulatesWith rf:SM_Blade_Right .

# --- SHACL refusals ----------------------------------------------------------
# (a) FLOATING_PART: a KinematicLink that is neither the RootLink nor the child
#     of some Joint is unreachable from the tree -> refuse. (Reachability of the
#     full parent chain to the Torso root is asserted procedurally by
#     scripts/verify_assembly_coherence.py, which walks the parentLink graph;
#     this shape catches the local "no parent joint at all" violation.)
law:FloatingPartShape a sh:NodeShape ;
    rdfs:label "Floating Part Shape"@en ;
    sh:targetClass law:KinematicLink ;
    sh:sparql [
        sh:message "FLOATING_PART: kinematic link is not the root and has no parent joint -> not reachable from the Torso root." ;
        sh:prefixes <https://rocket-craft.com/ontology/law#121_kinematic_connectivity_law> ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS { $this a law:RootLink }
                FILTER NOT EXISTS { ?j a law:Joint ; law:childLink $this }
            }
        """ ;
    ] .

# (b) DISCONNECTED_JOINT: a joint whose child link is not in metric contact with
#     its parent link. Contact is a geometric predicate (bbox overlap within a
#     tolerance) supplied at gate time as law:inContactWith by
#     scripts/verify_assembly_coherence.py. A joint lacking the contact assertion
#     between its declared parent and child is refused.
law:hasContactTolerance a owl:DatatypeProperty ;
    rdfs:label "contact tolerance (meters)"@en ; rdfs:range xsd:decimal .

law:inContactWith a owl:ObjectProperty ;
    rdfs:subPropertyOf ro:RO_0002170 ;
    rdfs:label "in metric contact with"@en ;
    rdfs:comment "Asserted at gate time when two links' bounding boxes overlap/touch within tolerance."@en .

law:DisconnectedJointShape a sh:NodeShape ;
    rdfs:label "Disconnected Joint Shape"@en ;
    sh:targetClass law:Joint ;
    sh:sparql [
        sh:message "DISCONNECTED_JOINT: joint child link is not in metric contact with its parent link." ;
        sh:prefixes <https://rocket-craft.com/ontology/law#121_kinematic_connectivity_law> ;
        sh:select """
            SELECT $this WHERE {
                $this law:parentLink ?parent ; law:childLink ?child .
                FILTER NOT EXISTS { ?parent law:inContactWith ?child }
                FILTER NOT EXISTS { ?child law:inContactWith ?parent }
            }
        """ ;
    ] .


# --- Source: 122_anti_mock_laundering_law.ttl ---
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix antillm: <https://ggen.io/ontology/anti_llm/> .
@prefix core: <https://ggen.io/ontology/core/> .

antillm:MockLaunderingViolation a owl:Class ;
    rdfs:subClassOf antillm:ForbiddenImplication ;
    rdfs:label "Mock Laundering Violation" ;
    rdfs:comment "A critical Jidoka failure where an LLM generates a fake artifact (e.g., an AI 2D image) to simulate standing without invoking the true Playwright execution and receiving a BLAKE3 receipt." .

antillm:MockAssetShape a sh:NodeShape ;
    sh:targetClass core:Asset ;
    sh:property [
        sh:path antillm:playwrightDeltaReceipt ;
        sh:minCount 1 ;
        sh:class antillm:Receipt ;
        sh:message "ASSET_ADMISSION_REJECTED: All core:Asset nodes MUST be physically backed by a Playwright visual delta receipt. Mock image generation is explicitly forbidden." ;
    ] ;
    sh:property [
        sh:path antillm:blake3Hash ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[a-f0-9]{64}$" ;
        sh:message "ASSET_ADMISSION_REJECTED: Asset lacks a valid BLAKE3 cryptographic hash sealing its rendering process." ;
    ] .


