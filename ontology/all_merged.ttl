@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix law: <https://ggen.io/ontology/law/> .

law:063_panel_line_language a owl:Ontology ;
    rdfs:label "Panel Line Language" .

law:PanelLine a owl:Class ;
    rdfs:subClassOf core:TopologyNode ;
    rdfs:label "Panel Line" ;
    rdfs:comment "Separation line grammar for modular breakups." .

law:hasPanelLine a owl:ObjectProperty ;
    rdfs:domain core:Entity ;
    rdfs:range law:PanelLine ;
    rdfs:label "has Panel Line" .

law:PanelLineShape a sh:NodeShape ;
    sh:targetClass law:PanelLine ;
    sh:property [
        sh:path core:isBounded ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "Panel lines MUST be bounded to prevent excessive recursion."
    ] .


