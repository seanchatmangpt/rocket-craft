law:067_micro_detail_density_law a owl:Ontology ;
    rdfs:label "Micro Detail Density and Greeble Law" .

law:Greeble a owl:Class ;
    rdfs:subClassOf core:TopologyNode ;
    rdfs:label "Greeble Detail" ;
    rdfs:comment "High-density micro-detail grammar for mechanical scale." .

law:hasGreeble a owl:ObjectProperty ;
    rdfs:domain core:Entity ;
    rdfs:range law:Greeble ;
