@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix gn: <https://ggen.io/ontology/mecha-nexus/> .
gn:MechaNexusOntology a owl:Ontology ;
    rdfs:label "Mecha Nexus Ontology" ;
    rdfs:comment "Constitutional semantic primitives for Combinatorial Maximalist universe manufacturing." .
# --- MECH PRIMITIVES ---
gn:MechAssembly a owl:Class ;
